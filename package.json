{
  "name": "crypto-gpt-discord-service",
  "version": "0.0.1",
  "license": "MIT",
  "author": "rarcifa",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#src/*": "./dist/*"
  },
  "scripts": {
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "prebuild": "npm run lint && tsc",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist",
    "migrate": "cross-env NODE_ENV=development && tsc && npx sequelize-cli db:migrate",
    "migrate-test": "tsc && npx sequelize-cli db:migrate --env test",
    "dev": "nodemon --watch src -e ts --exec 'npm run build && node dist'",
    "test": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@types/axios": "0.14.0",
    "@types/uuid": "9.0.3",
    "axios": "1.6.2",
    "body-parser": "1.20.2",
    "discord.js": "^14.12.1",
    "dotenv": "16.0.0",
    "lodash": "4.17.21",
    "readable-stream": "4.5.2",
    "winston": "3.10.0"
  },
  "devDependencies": {
    "@jest/globals": "27.4.6",
    "@types/jest": "27.0.3",
    "@types/lodash": "4.14.181",
    "@types/module-alias": "2.0.1",
    "@types/node": "20.4.10",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-ts-auto-mock": "^2.1.0",
    "nodemon": "^3.0.2",
    "prettier": "2.5.1",
    "ts-auto-mock": "^3.7.2",
    "ts-jest": "^29.1.2",
    "tslint-config-prettier": "1.18.0",
    "typescript": "^5.3.3"
  }
}
